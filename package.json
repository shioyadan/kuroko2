  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "css-loader": "7.1.4",
    "html-inline-script-webpack-plugin": "3.2.1",
    "html-webpack-plugin": "5.6.8",
    "pdfjs-dist": "4.8.69",
    "playwright-core": "1.65.0",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0",
    "worker-loader": "3.0.8"
