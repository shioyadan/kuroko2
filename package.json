{
  "name": "kuroko2",
  "version": "0.1.0",
  "private": true,
  "description": "Paste PowerPoint figures and save vector PDFs in a single HTML application",
  "author": "Ryota Shioya <shioya@ci.i.u-tokyo.ac.jp>",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.12.0"
